      {
        "command": "codeNotes.cancelMove",
        "key": "escape",
        "when": "codeNotes.moving && editorTextFocus && !suggestWidgetVisible && !findWidgetVisible"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codeNotes.add",
          "group": "z_codeNotes@1"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "codeNotes.askFromThread",
          "group": "inline@0",
          "when": "commentController == codeNotes && commentThread == stepAsk"
        },
        {
          "command": "codeNotes.createFromThread",
          "group": "inline",
          "when": "commentController == codeNotes && commentThreadIsEmpty && commentThread != stepAsk"
        },
        {
          "command": "codeNotes.reply",
          "group": "inline@1",
          "when": "commentController == codeNotes && !commentThreadIsEmpty && !(commentThread =~ /resolved/)"
        },
        {
          "command": "codeNotes.replyReopen",
          "group": "inline@1",
          "when": "commentController == codeNotes && !commentThreadIsEmpty && commentThread =~ /resolved/"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "codeNotes.cancelClaude",
          "group": "navigation@0",
          "when": "commentController == codeNotes && commentThread =~ /asking/"
        },
        {
          "command": "codeNotes.askClaude",
          "group": "navigation@0",
          "when": "commentController == codeNotes && config.codeNotes.claude.mode != 'off' && commentThread =~ /open/ && !(commentThread =~ /asking/) && codeNotes.claudeFound"
        },
        {
          "command": "codeNotes.resolve",
          "group": "navigation@4",
          "when": "commentController == codeNotes && commentThread =~ /open/"
        },
        {
          "command": "codeNotes.reopen",
          "group": "navigation@4",
          "when": "commentController == codeNotes && commentThread =~ /resolved/"
        }
      ],
      "view/title": [
        {
          "command": "codeNotes.nextUnread",
          "group": "navigation@1",
          "when": "view == codeNotes.notes && codeNotes.hasNotes"
        },
        {
          "command": "codeNotes.filter",
          "group": "0_find@2",
          "when": "view == codeNotes.notes && codeNotes.hasNotes && !codeNotes.filtered"
        },
        {
          "command": "codeNotes.filterActive",
          "group": "navigation@3",
          "when": "view == codeNotes.notes && codeNotes.filtered"
        },
        {
          "command": "codeNotes.resolveChecked",
          "group": "navigation@4",
          "when": "view == codeNotes.notes && codeNotes.hasChecked"
        },
        {
          "command": "codeNotes.showResolved",
          "group": "1_view@1",
          "when": "view == codeNotes.notes && codeNotes.hasNotes && !codeNotes.showResolved"
        },
        {
          "command": "codeNotes.hideResolved",
          "group": "1_view@1",
          "when": "view == codeNotes.notes && codeNotes.hasNotes && codeNotes.showResolved"
        },
        {
          "command": "codeNotes.resolveAll",
          "group": "2_bulk@2",
          "when": "view == codeNotes.notes && codeNotes.hasNotes"
        },
        {
          "command": "codeNotes.showAllSessions",
          "group": "1_view@2",
          "when": "view == codeNotes.notes && codeNotes.hasHiddenSessions"
        },
        {
          "command": "codeNotes.groupBySession",
          "group": "1_view@0",
          "when": "view == codeNotes.notes && codeNotes.groupBy == 'file' && codeNotes.hasSessions"
        },
        {
          "command": "codeNotes.groupByFile",
          "group": "1_view@0",
          "when": "view == codeNotes.notes && codeNotes.groupBy == 'session' && codeNotes.hasSessions"
        },
        {
          "command": "codeNotes.markAllRead",
          "group": "2_bulk@3",
          "when": "view == codeNotes.notes && codeNotes.hasNotes"
        },
        {
          "command": "codeNotes.deleteResolved",
          "group": "2_bulk@4",
          "when": "view == codeNotes.notes && codeNotes.hasNotes"
        },
        {
          "command": "codeNotes.copyAgentPrompt",
          "group": "2_bulk@5",
          "when": "view == codeNotes.notes && codeNotes.hasNotes"
        }
      ],
      "view/item/context": [
        {
          "command": "codeNotes.acceptCode",
          "group": "inline@1",
          "when": "view == codeNotes.notes && viewItem =~ /^note/ && viewItem =~ /stale/"
        },
        {
          "command": "codeNotes.resolve",
          "group": "inline@2",
          "when": "view == codeNotes.notes && viewItem =~ /^note/ && viewItem =~ /open/"
        },
        {
          "command": "codeNotes.reopen",
          "group": "inline@2",
          "when": "view == codeNotes.notes && viewItem =~ /^note/ && viewItem =~ /resolved/"
        },
        {
          "command": "codeNotes.resolve",
          "group": "1_note@1",
          "when": "view == codeNotes.notes && viewItem =~ /^note/ && viewItem =~ /open/"
        },
        {
          "command": "codeNotes.reopen",
          "group": "1_note@1",
          "when": "view == codeNotes.notes && viewItem =~ /^note/ && viewItem =~ /resolved/"
        },
        {
          "command": "codeNotes.copyNotePrompt",
          "group": "1_note@2",
          "when": "view == codeNotes.notes && viewItem =~ /^note/"
        },
        {
          "command": "codeNotes.moveToSelection",
          "group": "1_note@3",
          "when": "view == codeNotes.notes && viewItem =~ /^note/ && viewItem =~ /stale/"
        },
        {
          "command": "codeNotes.acceptCode",
          "group": "1_note@4",
          "when": "view == codeNotes.notes && viewItem =~ /^note/ && viewItem =~ /stale/"
        },
        {
          "command": "codeNotes.openNoteFile",
          "group": "2_file@1",
          "when": "view == codeNotes.notes && viewItem =~ /^note/"
        },
        {
          "command": "codeNotes.delete",
          "group": "3_danger@1",
          "when": "view == codeNotes.notes && viewItem =~ /^note/"
        },
        {
          "command": "codeNotes.hideSession",
          "group": "inline@1",
          "when": "view == codeNotes.notes && viewItem =~ /^session/ && viewItem =~ /shown/"
        },
        {
          "command": "codeNotes.showSession",
          "group": "inline@1",
          "when": "view == codeNotes.notes && viewItem =~ /^session/ && viewItem =~ /hidden/"
        },
        {
          "command": "codeNotes.showOnlySession",
          "group": "inline@2",
          "when": "view == codeNotes.notes && viewItem =~ /^session/"
        },
        {
          "command": "codeNotes.showOnlySession",
          "group": "1_session@1",
          "when": "view == codeNotes.notes && viewItem =~ /^session/"
        },
        {
          "command": "codeNotes.showAllSessions",
          "group": "1_session@2",
          "when": "view == codeNotes.notes && viewItem =~ /^session/ && codeNotes.hasHiddenSessions"
        },
        {
          "command": "codeNotes.resolveSession",
          "group": "2_session@1",
          "when": "view == codeNotes.notes && viewItem =~ /^session/ && viewItem =~ /named/"
        },
        {
          "command": "codeNotes.deleteSession",
          "group": "3_danger@1",
          "when": "view == codeNotes.notes && viewItem =~ /^session/ && viewItem =~ /named/"
        },
        {
          "command": "codeNotes.reveal",
          "group": "0_open@1",
          "when": "view == codeNotes.notes && viewItem =~ /^note/"
        },
        {
          "command": "codeNotes.markUnread",
          "group": "1_note@5",
          "when": "view == codeNotes.notes && viewItem =~ /^note/ && viewItem =~ /replied/ && !(viewItem =~ /unread/)"
        },
        {
          "command": "codeNotes.askClaude",
          "group": "0_open@2",
          "when": "view == codeNotes.notes && viewItem =~ /^note/ && !(viewItem =~ /resolved/) && !(viewItem =~ /asking/) && config.codeNotes.claude.mode != 'off' && codeNotes.claudeFound"
        },
        {
          "command": "codeNotes.cancelClaude",
          "group": "0_open@3",
          "when": "view == codeNotes.notes && viewItem =~ /^note/ && viewItem =~ /asking/"
        },
        {
          "command": "codeNotes.restoreBroken",
          "group": "1_broken@1",
          "when": "view == codeNotes.notes && viewItem =~ /^broken;known/"
        },
        {
          "command": "codeNotes.openBroken",
          "group": "1_broken@2",
          "when": "view == codeNotes.notes && viewItem =~ /^broken/"
        }
      ],
      "commandPalette": [
        {
          "command": "codeNotes.reply",
          "when": "false"
        },
        {
          "command": "codeNotes.createFromThread",
          "when": "false"
        },
        {
          "command": "codeNotes.reveal",
          "when": "false"
        },
        {
          "command": "codeNotes.resolveChecked",
          "when": "codeNotes.hasChecked"
        },
        {
