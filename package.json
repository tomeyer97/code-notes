      "explorer/context": [
        {
          "command": "codeNotes.addPathNote",
          "group": "z_codeNotes@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "codeNotes.addPathNote",
          "group": "z_codeNotes@1",
          "when": "resourceScheme != code-notes-folder && resourceScheme != code-notes-note && resourceScheme != untitled"
        }
      ]
    },
    "configuration": {
      "title": "Code Notes",
      "properties": {
        "codeNotes.author": {
          "type": "string",
          "default": "",
          "description": "Your name on notes and replies. Empty: your git user.name. Messages from anyone else (e.g. an agent) show as unread until you open them."
        },
        "codeNotes.folder": {
          "type": "string",
          "default": ".code-notes",
          "description": "Folder (relative to the workspace folder) holding one JSON file per note. Changing it offers to move the notes. Must be a sub-folder of its own (not \".\" or outside the workspace)."
        },
        "codeNotes.ignoreInGit": {
          "type": "boolean",
          "default": true,
          "description": "Keep notes out of git (a .gitignore in the notes folder). Off: notes can be committed; the trash stays out of git."
        },
        "codeNotes.highlight": {
          "type": "boolean",
          "default": true,
          "description": "Tint lines that have an open note."
        },
        "codeNotes.showResolvedInEditor": {
          "type": "boolean",
          "default": false,
          "description": "Keep resolved notes' threads in the editor (collapsed)."
        },
        "codeNotes.claude.mode": {
          "type": "string",
          "enum": [
            "button",
            "always",
            "off"
          ],
          "default": "button",
          "enumDescriptions": [
            "An \"Ask Claude\" button on the note box, threads and the list.",
            "Every new note and reply goes to Claude right away.",
            "No Claude."
          ],
          "description": "Answer notes with Claude Code (the newest `claude` CLI found, your existing login). Claude can read the code but not change it (and can use the skills in Code Notes › Claude: Skills). Ask Claude shows only when the `claude` CLI is found (install Claude Code, or set Code Notes › Claude: Path)."
        },
        "codeNotes.claude.model": {
          "type": "string",
          "default": "",
          "description": "Model for answers (e.g. \"sonnet\" for cheaper, faster answers). Empty: Claude Code's default."
        },
        "codeNotes.claude.path": {
          "type": "string",
          "default": "",
          "description": "Path to the `claude` CLI. Empty: found on PATH or in the usual install places."
        },
        "codeNotes.claude.skills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Names of Claude Code skills (folders in ~/.claude/skills) that Ask Claude may use. Claude may run only those skills' own scripts; editing files and other commands stay blocked."
        },
        "codeNotes.journeys.folder": {
          "type": "string",
          "default": "journeys",
          "description": "Folder (relative to the workspace folder) holding the repository's journeys, committed and shared with the team. Journeys in the notes folder's journeys/ are read too (personal ones, the old place); with the same id, the one here wins."
        },
        "codeNotes.journeys.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Outside a journey walk, one quiet line above code a journey step is about (\"◇ Step 3 of Place an order\"); click it to open that journey at that step."
        },
        "codeNotes.journeys.authorMode": {
          "type": "boolean",
          "default": false,
          "description": "For journey authors: the map shows how many of the format's rules a journey breaks (the list in the Output panel)."
        },
        "codeNotes.journeys.model": {
          "type": "string",
          "default": "",
          "description": "Model Claude Code uses to write a journey from the journey picker (\"Ask the agent to write a journey…\"). Empty: Code Notes › Claude: Model, else Claude Code's default."
        }
      }
    },
    "colors": [
      {
        "id": "codeNotes.stepBackground",
        "description": "Background of the journey step's lines while you walk it (a faint tint of the step bar).",
        "defaults": {
          "dark": "#3794ff1c",
          "light": "#006ab114",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      },
      {
        "id": "codeNotes.noteBackground",
        "description": "Background of lines with an open note.",
        "defaults": {
          "dark": "#a371f726",
          "light": "#8250df12",
          "highContrast": "#a371f726"
        }
      },
      {
        "id": "codeNotes.noteBorder",
        "description": "Left bar of lines with an open note.",
        "defaults": {
          "dark": "#a371f7aa",
          "light": "#8250dfcc",
          "highContrast": "#d2a8ff"
        }
      },
      {
        "id": "codeNotes.noteRuler",
        "description": "Scrollbar mark of an open note.",
        "defaults": {
          "dark": "#a371f7",
          "light": "#8250df",
          "highContrast": "#d2a8ff"
        }
      },
      {
        "id": "codeNotes.staleBackground",
        "description": "Background of lines whose note is stale.",
        "defaults": {
          "dark": "#d4a01714",
          "light": "#e8a20024",
          "highContrast": "#d4a01733"
        }
      },
      {
        "id": "codeNotes.unreadForeground",
        "description": "Unread marker in the Notes view and the scrollbar.",
        "defaults": {
          "dark": "#3794ff",
          "light": "#1a73e8",
          "highContrast": "#3794ff"
        }
      },
      {
        "id": "codeNotes.selectionBackground",
        "description": "The exact text a note is about, when it was part of a line (under a dotted line).",
        "defaults": {
          "dark": "#a371f71f",
          "light": "#8250df17",
          "highContrast": "#00000000"
        }
      }
    ],
    "configurationDefaults": {
      "comments.openView": "never",
      "comments.maxHeight": false,
      "editor.smoothScrolling": true
    }
  },
  "scripts": {
    "build": "tsc -p . && npm run -s vendor",
    "vendor": "node -e \"const f=require('fs');f.mkdirSync('out/vendor',{recursive:true});f.copyFileSync('node_modules/elkjs/lib/elk.bundled.js','out/vendor/elk.bundled.js');f.copyFileSync('node_modules/elkjs/LICENSE.md','out/vendor/elk-LICENSE.md')\"",
    "test": "tsc -p . && node --test out/test/*.test.js",
    "package": "vsce package --no-dependencies",
    "test:integration": "npm run -s build && env -u ELECTRON_RUN_AS_NODE xvfb-run -a node out/test/integration/run.js",
    "test:scenes": "node test/journey-scene/check.mjs test/journey-scene/sample.json",
    "test:panel": "node test/journey-map/shoot.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode notes and journeys can be read and written, but Claude never runs (answering notes and steps, writing journeys): trust the folder for that.",
      "restrictedConfigurations": [
        "codeNotes.claude.path",
        "codeNotes.claude.model",
        "codeNotes.claude.mode",
        "codeNotes.claude.skills",
        "codeNotes.journeys.model"
      ]
    },
    "virtualWorkspaces": false
  },
  "dependencies": {
    "elkjs": "0.10.0"
  }
}
