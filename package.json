{
  "name": "code-notes",
  "displayName": "Code Notes",
  "description": "Notes on code that your coding agent answers in threads, and Code Journeys: guided, animated walks through how a codebase works.",
  "version": "0.23.0",
  "publisher": "tomeyer97",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1b4b",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tomeyer97/code-notes.git"
  },
  "homepage": "https://github.com/tomeyer97/code-notes#readme",
  "bugs": {
    "url": "https://github.com/tomeyer97/code-notes/issues"
  },
  "keywords": [
    "notes",
    "code review",
    "comments",
    "ai",
    "claude",
    "agent",
    "code tour",
    "walkthrough",
    "onboarding",
    "architecture"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other",
    "Education",
    "Visualization"
  ],
  "main": "./out/src/extension.js",
  "files": [
    "out/src/**/*.js",
    "out/vendor/**",
    "media/**",
    "skills/code-journey/SKILL.md",
    "skills/code-journey/scripts/journey.py",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:codeNotes.journey",
    "onUri"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeNotes",
          "title": "Code Notes",
          "icon": "media/notes.svg"
        }
      ]
    },
    "views": {
      "codeNotes": [
        {
          "id": "codeNotes.notes",
          "name": "Code Notes"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "codeNotes.notes",
        "contents": "Select code and press Ctrl+' C to leave a note.\n[Add a Note](command:codeNotes.add)"
      }
    ],
